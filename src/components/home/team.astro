---
import Bandit from "@assets/media/team/bandit_site.png";
import Gizmo from "@assets/media/team/gizmo_site.png";
import Kirk from "@assets/media/team/kirk_site.png";
import Leo from "@assets/media/team/leo_site.png";
import Pepe from "@assets/media/team/Pepe_site-1.png";
import CB from "@assets/media/team/cb.jpg";

import Jayro from "@assets/media/team/jayro.png";
import AAA3A from "@assets/media/team/AAA3A.png";
import LordSkeletonMan from "@assets/media/team/lord_skeletonman.png";
import Mel from "@assets/media/team/mel.png";
import Julie from "@assets/media/team/julie.png";

import { Picture } from "@astrojs/image/components";
---

<div
  class="max-w-6xl mx-auto bg-black/75 rounded shadow-2xl px-8 pt-3 pb-10 divide-y-4"
>
  <div class="text-center py-5">
    <h2 class="text-slate-200 text-4xl lg:text-5xl font-bold lg:tracking-tight">
      Team - ᓚᘏᗢ
    </h2>
    <p class="text-lg mt-4 text-slate-300">Meet the team behind Medicat</p>
  </div>

  <!-- MON5TERMATT + cats -->
  <div class="py-5">
    <div class="flex flex-wrap justify-center items-start gap-8 lg:gap-16">
      <div class="w-60">
        <a href="https://mon5termatt.com" target="_blank">
          <img
            class="rounded w-full"
            src="/team-matt.gif"
            alt="MON5TERMATT"
            width="210"
            height="210"
            loading="eager"
          />
          <h2
            class="mt-2 text-center text-blue-600 text-2xl lg:text-3xl font-bold lg:tracking-tight"
          >
            MON5TERMATT
          </h2>
          <p class="text-center text-slate-300">
            Site Designer and Developer <br />
            Giant Homelab Nerd
          </p>
        </a>
      </div>

      <div class="flex flex-wrap justify-center items-start gap-4">
        <div class="w-48">
          <a href="https://www.youtube.com/watch?v=M3tIYdMR_Ao" target="_blank">
            <Picture
              class="rounded"
              src={Kirk}
              widths={[100, 210]}
              alt="Kirk"
              loading="eager"
              format="avif"
            />
            <h2
              class="mt-2 text-center text-blue-600 text-2xl lg:text-3xl font-bold lg:tracking-tight"
            >
              Kirk
            </h2>
          </a>
        </div>

        <div class="w-48">
          <Picture
            class="rounded"
            src={Bandit}
            widths={[100, 210]}
            alt="Bandit"
            loading="eager"
            format="avif"
          />
          <h2
            class="mt-2 text-center text-blue-600 text-2xl lg:text-3xl font-bold lg:tracking-tight"
          >
            Bandit
          </h2>
        </div>

        <div class="w-48">
          <Picture
            class="rounded"
            src={CB}
            widths={[100, 210]}
            alt="CB"
            loading="eager"
            format="avif"
          />
          <h2
            class="mt-2 text-center text-blue-600 text-2xl lg:text-3xl font-bold lg:tracking-tight"
          >
            CB
          </h2>
        </div>
      </div>
    </div>
  </div>

  <!-- Jayro + cats -->
  <div class="py-5">
    <div class="flex flex-wrap justify-center items-start gap-8 lg:gap-16">
      <div class="w-60">
        <a href="https://linktr.ee/jayrojones" target="_blank">
          <Picture
            class="rounded"
            src={Jayro}
            widths={[100, 210]}
            alt="Jayro"
            loading="eager"
            format="avif"
          />
          <h2
            class="mt-2 text-center text-blue-600 text-2xl lg:text-3xl font-bold lg:tracking-tight"
          >
            Jayro
          </h2>
          <p class="text-center text-slate-300">
            Medicat Owner and Designer <br />
            Gameboy Modder
          </p>
        </a>
      </div>

      <div class="flex flex-wrap justify-center items-start gap-4">
        <div class="w-48">
          <a href="https://www.youtube.com/watch?v=HeZpkv62L5g" target="_blank">
            <Picture
              class="rounded"
              src={Pepe}
              widths={[100, 210]}
              alt="Pepe"
              loading="eager"
              format="avif"
            />
            <h2
              class="mt-2 text-center text-blue-600 text-2xl lg:text-3xl font-bold lg:tracking-tight"
            >
              Pepe
            </h2>
          </a>
        </div>

        <div class="w-48">
          <Picture
            class="rounded"
            src={Leo}
            widths={[100, 210]}
            alt="Leo"
            loading="eager"
            format="avif"
          />
          <h2
            class="mt-2 text-center text-blue-600 text-2xl lg:text-3xl font-bold lg:tracking-tight"
          >
            Leo
          </h2>
        </div>

        <div class="w-48">
          <Picture
            class="rounded"
            src={Gizmo}
            widths={[100, 210]}
            alt="Gizmo"
            loading="eager"
            format="avif"
          />
          <h2
            class="mt-2 text-center text-blue-600 text-2xl lg:text-3xl font-bold lg:tracking-tight"
          >
            Gizmo
          </h2>
        </div>
      </div>
    </div>
  </div>

  <!-- Contributors row (up to 5 across) -->
  <div class="pt-5">
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 justify-items-center">
      <div class="w-full max-w-[9.5rem]">
        <a href="https://www.buymeacoffee.com/aaa3a" target="_blank">
          <Picture
            class="rounded"
            src={AAA3A}
            widths={[100, 152]}
            alt="AAA3A"
            loading="eager"
            format="avif"
          />
          <h2
            class="mt-2 text-center text-blue-600 text-base lg:text-lg font-bold lg:tracking-tight"
          >
            AAA3A
          </h2>
        </a>
      </div>

      <div class="w-full max-w-[9.5rem]">
        <a href="https://expand.sh/" target="_blank">
          <img
            class="rounded w-full"
            src="/team-expand.webp"
            alt="Expand"
            width="152"
            height="152"
            loading="eager"
          />
          <h2
            class="mt-2 text-center text-blue-600 text-base lg:text-lg font-bold lg:tracking-tight"
          >
            Expand
          </h2>
        </a>
      </div>

      <div class="w-full max-w-[9.5rem]">
        <img
          class="rounded w-full"
          src="/team-camellia.webp"
          alt="Camellia"
          width="152"
          height="152"
          loading="eager"
        />
        <h2
          class="mt-2 text-center text-blue-600 text-base lg:text-lg font-bold lg:tracking-tight"
        >
          Camellia
        </h2>
      </div>

      <div class="w-full max-w-[9.5rem]">
        <Picture
          class="rounded"
          src={LordSkeletonMan}
          widths={[100, 152]}
          alt="Lord SkeletonMan"
          loading="eager"
          format="avif"
        />
        <h2
          class="mt-2 text-center text-blue-600 text-base lg:text-lg font-bold lg:tracking-tight"
        >
          Lord SkeletonMan
        </h2>
      </div>

      <div class="w-full max-w-[9.5rem]">
        <a href="https://fox.pet/" target="_blank">
          <Picture
            class="rounded"
            src={Mel}
            widths={[100, 152]}
            alt="Mel"
            loading="eager"
            format="avif"
          />
          <h2
            class="mt-2 text-center text-blue-600 text-base lg:text-lg font-bold lg:tracking-tight"
          >
            Mel
          </h2>
        </a>
      </div>

      <div class="w-full max-w-[9.5rem]">
        <a href="https://zoey-on-github.github.io/" target="_blank">
          <Picture
            class="rounded"
            src={Julie}
            widths={[100, 152]}
            alt="Julie λ"
            loading="eager"
            format="avif"
          />
          <h2
            class="mt-2 text-center text-blue-600 text-base lg:text-lg font-bold lg:tracking-tight"
          >
            Julie λ
          </h2>
        </a>
      </div>
    </div>
  </div>
</div>
