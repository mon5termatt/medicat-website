---
const surveyUrl =
  "https://forms.mon5termatt.com/forms/medicat-tools-survey-what-do-you-use-c9yt0i";

const nfConfig = JSON.stringify({
  formurl: surveyUrl,
  emoji: "💬",
  position: "left",
  bgcolor: "#ff9500",
  width: 500,
});
---

<div
  id="tools-survey-banner"
  class="fixed bottom-4 left-1/2 z-40 hidden w-[min(48rem,calc(100%-2rem))] -translate-x-1/2"
  role="complementary"
  aria-label="Medicat tools survey"
  hidden
>
  <div
    class="rounded-lg border border-white/15 bg-black/90 px-5 py-4 text-slate-200 shadow-2xl backdrop-blur-sm"
  >
    <div class="flex items-start gap-4">
      <div class="min-w-0 flex-1 text-center">
        <p class="text-sm font-semibold text-white">Help shape Medicat 2026</p>
        <p class="mt-1 text-xs leading-relaxed text-slate-300 sm:text-sm">
          Quick survey on which tools you still use — helps decide what to keep,
          update, or drop.
        </p>
        <button
          type="button"
          data-survey-open
          class="mt-3 inline-block rounded bg-white px-4 py-2 text-xs font-semibold text-black transition hover:bg-slate-200"
        >
          Take the survey
        </button>
      </div>
      <button
        type="button"
        class="shrink-0 rounded px-1.5 py-0.5 text-sm text-slate-400 transition hover:bg-white/10 hover:text-white"
        data-survey-dismiss
        aria-label="Dismiss survey banner"
      >
        ✕
      </button>
    </div>

    <div
      id="tools-survey-confirm"
      class="mt-3 hidden border-t border-white/10 pt-3 text-center"
      hidden
      role="dialog"
      aria-labelledby="tools-survey-confirm-title"
    >
      <p id="tools-survey-confirm-title" class="text-sm font-medium text-white">
        Dismiss this reminder?
      </p>
      <p class="mt-1 text-xs text-slate-400">
        You can still take the survey later if you change your mind.
      </p>
      <div class="mt-3 flex justify-center gap-2">
        <button
          type="button"
          data-survey-confirm-cancel
          class="rounded border border-white/20 bg-white/5 px-3 py-1.5 text-xs font-medium text-slate-200 transition hover:bg-white/10"
        >
          Keep it
        </button>
        <button
          type="button"
          data-survey-confirm-yes
          class="rounded bg-white px-3 py-1.5 text-xs font-semibold text-black transition hover:bg-slate-200"
        >
          Dismiss
        </button>
      </div>
    </div>
  </div>
</div>

<style is:global>
  /* Hide OpnForm floater when closed; show only as close control when open */
  .nf-main:not(.open) .nf-emoji {
    display: none !important;
  }

  /* Embed defaults to 450px — stretch it for the multi-page survey */
  .nf-main .nf-popup iframe {
    height: min(80vh, 720px) !important;
  }
</style>

<script
  is:inline
  async
  data-nf={nfConfig}
  src="https://forms.mon5termatt.com/widgets/embed-min.js"
></script>

<script>
  const STORAGE_KEY = "medicat-tools-survey-dismissed";

  function getEmbedButton() {
    return document.querySelector(".nf-main .nf-emoji");
  }

  function openSurveyEmbed() {
    const main = document.querySelector(".nf-main");
    if (main?.classList.contains("open")) return true;

    const emoji = getEmbedButton();
    if (emoji instanceof HTMLElement) {
      emoji.click();
      return true;
    }
    return false;
  }

  function waitForEmbedButton(attempts = 40) {
    return new Promise((resolve) => {
      const tick = (left) => {
        const emoji = getEmbedButton();
        if (emoji || left <= 0) {
          resolve(emoji);
          return;
        }
        setTimeout(() => tick(left - 1), 100);
      };
      tick(attempts);
    });
  }

  function initToolsSurveyBanner() {
    const root = document.getElementById("tools-survey-banner");
    const confirmBox = document.getElementById("tools-survey-confirm");
    if (!root || !confirmBox) return;
    if (localStorage.getItem(STORAGE_KEY) === "1") return;

    const showConfirm = () => {
      confirmBox.hidden = false;
      confirmBox.classList.remove("hidden");
    };

    const hideConfirm = () => {
      confirmBox.hidden = true;
      confirmBox.classList.add("hidden");
    };

    const dismissBanner = () => {
      root.hidden = true;
      root.classList.add("hidden");
      localStorage.setItem(STORAGE_KEY, "1");
    };

    root.querySelectorAll("[data-survey-dismiss]").forEach((el) => {
      el.addEventListener("click", showConfirm);
    });

    root.querySelectorAll("[data-survey-confirm-cancel]").forEach((el) => {
      el.addEventListener("click", hideConfirm);
    });

    root.querySelectorAll("[data-survey-confirm-yes]").forEach((el) => {
      el.addEventListener("click", dismissBanner);
    });

    root.querySelectorAll("[data-survey-open]").forEach((el) => {
      el.addEventListener("click", async () => {
        if (openSurveyEmbed()) return;
        await waitForEmbedButton();
        openSurveyEmbed();
      });
    });

    root.hidden = false;
    root.classList.remove("hidden");
  }

  initToolsSurveyBanner();
</script>
